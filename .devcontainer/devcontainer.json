{
  "name": "API-workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",
  "postCreateCommand": "npm install",
  "postAttachCommand": {
    "server": "npm run dev"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Conference schedule",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "server/src/routes.ts"]
    }
  }
}
